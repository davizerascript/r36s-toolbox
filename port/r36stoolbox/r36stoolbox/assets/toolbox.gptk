# R36S Toolbox — mapa para dialog
# A seleciona, B volta/sai, X/Y navegam páginas.
a = enter
b = escape
x = pageup
y = pagedown
start = enter
select = escape
back = escape
guide = enter
l1 = tab
r1 = backspace
l2 = home
r2 = end
up = up
down = down
left = left
right = right
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
